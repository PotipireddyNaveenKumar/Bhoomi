# ============================================================
# BHOOMI V2 — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure real credentials for deployment
# ============================================================

# Environment Selection: development | staging | production
ENVIRONMENT=production
APP_ENV=production
DEBUG=False
LOG_LEVEL=INFO

# Application Security
# Generate secure key: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database Persistence (PostgreSQL for production; SQLite for local dev)
# Production: postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>
DATABASE_URL=
DATABASE_SYNC_URL=

# Cache & Distributed Transient State (Redis)
REDIS_URL=

# Voice Processing Engine (Sarvam AI Saaras STT & Bulbul TTS)
VOICE_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3

# LLM Language Orchestration (gemini | openai | groq)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Vector Database (chroma | pgvector | qdrant)
VECTOR_DB_PROVIDER=chroma
CHROMA_PERSIST_DIR=./data/chroma

# Meteorological Service (openweathermap | openmeteo)
WEATHER_PROVIDER=openmeteo
WEATHER_API_KEY=

# APMC Mandi Wholesale Price Feed (data_gov Agmarknet)
MARKET_PROVIDER=data_gov
DATA_GOV_API_KEY=

# Object Storage for Crop Leaf Pathology Images (local | s3 | r2)
OBJECT_STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# CORS Allowed Origins (JSON array or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:8085"]
